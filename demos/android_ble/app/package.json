{
  "name": "eris-ble",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "ui:update": "npm install @robiolab/native-ui@file:../../../../robiolab/robiolab_native_ui",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@robiolab/native-ui": "file:../../../../robiolab/robiolab_native_ui",
    "@shopify/react-native-skia": "2.2.12",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-status-bar": "~3.0.9",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-ble-plx": "^3.5.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "^0.5.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "^55.0.16",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.14",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|nativewind|react-native-reanimated|@shopify/react-native-skia|react-native-ble-plx|@robiolab/.*)"
    ]
  }
}
