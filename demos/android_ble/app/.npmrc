# Install file: dependencies (@robiolab/native-ui) as a copy, not a symlink, so Metro,
# Tailwind and jest resolve its imports from this app's node_modules.
#
# The copy does NOT refresh on a plain `npm install`. After changing robiolab_native_ui:
# bump its "version" in robiolab_native_ui/package.json, then run `npm run ui:update` here.
install-links=true
